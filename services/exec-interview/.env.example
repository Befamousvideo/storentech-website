# Copy to .env on the owner PC. Never commit .env.

# Public links printed by the key CLI. Placeholder only in git.
SITE_PUBLIC_URL=https://www.storentechai.com

# SHA-256 hex of each role's access key. Generate with:
#   python -m scripts.generate_key --role ceo
# Store hashes here. The raw key is printed once and is not saved.
INTERVIEW_KEY_HASH_CEO=
INTERVIEW_KEY_HASH_CFO=
INTERVIEW_KEY_HASH_OPS=

# Display code stored in Postgres. Not a client name.
COMPANY_CODE=111

# Questions file mounted into the container. Real file is gitignored.
QUESTIONS_PATH=/app/questions.json

# Postgres on the existing hardened network. New database + least-privilege user.
DATABASE_URL=postgresql://exec_interview:change-me@storentech_postgres:5432/exec_interviews

# Superuser URL used only by `python -m scripts.migrate --provision`.
# Leave empty after the database and role exist.
DATABASE_ADMIN_URL=postgresql://postgres:change-me@storentech_postgres:5432/postgres
DATABASE_NAME=exec_interviews
DATABASE_USER=exec_interview
DATABASE_PASSWORD=change-me

# CORS. Production origins are fixed. Add a local Next.js origin for laptop testing.
CORS_DEV_ORIGIN=http://localhost:3000

# Bind inside the container. Compose publishes 127.0.0.1:8443 only.
PORT=8443

# Whisper on the private compose network. Not published to the host.
WHISPER_URL=http://whisper:8000
# multipart (default) = POST {WHISPER_URL}{WHISPER_PATH} with field WHISPER_FILE_FIELD
# openai = POST {WHISPER_URL}/v1/audio/transcriptions (faster-whisper-server / speaches)
WHISPER_MODE=multipart
WHISPER_PATH=/transcribe
WHISPER_FILE_FIELD=file
WHISPER_MODEL=whisper-1
WHISPER_TIMEOUT_SECONDS=180

# Rate limits (in memory only; never persisted).
RATE_LIMIT_PER_MINUTE=60
TRANSCRIBE_LIMIT_PER_MINUTE=8
