{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storentechai.com/schemas/exec-interview-questions.json",
  "title": "Executive interview questions",
  "type": "object",
  "required": ["company_label", "roles"],
  "additionalProperties": false,
  "properties": {
    "company_label": {
      "type": "string",
      "minLength": 1,
      "description": "Display label only. Use a code such as Company 111. Never a client legal name, place name, or facility trade name."
    },
    "roles": {
      "type": "object",
      "required": ["ceo", "cfo", "ops"],
      "additionalProperties": false,
      "properties": {
        "ceo": { "$ref": "#/$defs/roleBlock" },
        "cfo": { "$ref": "#/$defs/roleBlock" },
        "ops": { "$ref": "#/$defs/roleBlock" }
      }
    }
  },
  "$defs": {
    "roleBlock": {
      "type": "object",
      "required": ["role_title", "intro", "questions"],
      "additionalProperties": false,
      "properties": {
        "role_title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "minLength": 1 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "text", "tag", "follow_ups"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Facility-neutral wording. Say your facility. Call the assistant product your AI Chief of Staff. No place names or other product brands."
        },
        "tag": { "type": "string", "enum": ["must", "if_time"] },
        "follow_ups": { "type": "boolean" }
      }
    }
  }
}
