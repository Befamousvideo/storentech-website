# Public site origin used for metadata, sitemap, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://storentech.com

# Optional. If set, contact-form and /roi-analysis submissions are POSTed as JSON to this URL (handoff to vincent@storentech.com).
INQUIRY_WEBHOOK_URL=

# Optional. Vapi PUBLIC key only — never a private/secret key.
# Widget stays off until this is set. Assistant id is 9e0a6184-ccc7-49d2-9ef0-31acfac1cf59
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
