# Public site origin used for metadata, sitemap, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://www.storentechai.com

# Start analysis CTA. Default is the Workspace Google Form. Swap to
# https://onboarding.storentechai.com when ONB1 is gated live.
NEXT_PUBLIC_INTAKE_URL=https://docs.google.com/forms/d/e/1FAIpQLScjOa8fFyqRLRAmOyDNtk7oFLlVwGwNdyML7VQNvWIUtlsXRg/viewform

# Optional. If set, contact-form submissions are POSTed as JSON to this URL.
INQUIRY_WEBHOOK_URL=

# Browser-only base URL for private /ceo /cfo /ops pages.
# Placeholder hostname only. Set the real Funnel origin in Vercel, not in git.
# Example: https://storentechai26.example.ts.net:8443
NEXT_PUBLIC_INTERVIEW_API=

# Optional. Google Search Console HTML-tag token. Leave blank to skip the tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. Bing Webmaster Tools msvalidate.01 token. Leave blank to skip the tag.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
